# 【生产】环境变量 - 覆盖通用配置

# 环境标识
VITE_APP_ENV = production
VITE_BASE_URL = /

# 项目名称
VITE_APP_TITLE = RealSexy Admin

# wangEditor 上传等组件用的接口前缀；与 .env 的 VITE_APP_BASE_API（axios baseURL）是两个不同键，都需保留
VITE_API_URL = /api/v1

# Vite dev 代理目标。生产构建不起 dev server，此值只用于构建日志展示、不参与生产请求；
# 生产请求走 .env 的 VITE_APP_BASE_API + Nginx 同源反代。保留占位避免 vite.config 取空值。
VITE_API_BASE_URL = http://127.0.0.1:8001

# 是否删除控制台输出
VITE_DROP_CONSOLE = true

# WebSocket 端点（Nginx 443 已对 /api/v1 开启 Upgrade 转发）
VITE_APP_WS_ENDPOINT = wss://admin.realsxy.cn


